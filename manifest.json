{
  "manifest_version": 3,
  "name": "Jenkins Onboarding",
  "version": "2.1.0",
  "key": "",
  "description": "Automate Jenkins user onboarding across Jira, Jenkins, Slack, and Yopass",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jenkins-onboarding-extension@tsagas",
      "strict_min_version": "126.0",
      "update_url": "https://tsagas.github.io/jenkins-onboarding-extension/update.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content-jenkins.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*/*"],
      "js": ["content-slack.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*/*"],
      "js": ["content-yopass.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*/*"],
      "js": ["content-jira.js"],
      "run_at": "document_idle"
    }
  ]
}
